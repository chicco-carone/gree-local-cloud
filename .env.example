# Published container image.
GREE_IMAGE=ghcr.io/chicco-carone/gree-local-cloud:latest
# Required: actual LAN IPv4 address of your Docker host.
GREE_SERVER_IP=
# AC LAN address and identifiers (without colons for the identifiers).
GREE_DEVICE_IP=
GREE_MODULE_MAC=
GREE_UNIT_MAC=
GREE_NAME=Gree AC
GREE_MODEL=U-WB04BRT13
GREE_LISTEN_PORT=1982
GREE_POLL_INTERVAL=20
GREE_DNS_NAMES=eu.dis.gree.com,mqtt-eu.gree.com
MQTT_HOST=mqtt.example.local
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# Set false to use plain MQTT without Home Assistant discovery.
HA_DISCOVERY=true
# Swing menu language: en (English) or it (Italian).
LANGUAGE=en
# Optional external room temperature: a numeric Celsius payload.
TEMPERATURE_TOPIC=
TZ=UTC
# Ownership of ./data must match this container user.
GREE_UID=1000
GREE_GID=1000
